    <!-- SCRIPTS -->
    <script>
        // 1. SCROLL REVEAL
        const obs = new IntersectionObserver((entries) => {
            entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('active'); });
        }, { threshold: 0.1 });
        document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

        // 2. STICKY MOBILE CTA LOGIC
        const stickyCta = document.getElementById('stickyCta');
        const heroSection = document.getElementById('heroSection');
        const pricingSection = document.getElementById('pricing');
        let pastHero = false;
        let inPricing = false;

        function updateSticky() {
            if (pastHero && !inPricing) {
                stickyCta.classList.add('visible');
            } else {
                stickyCta.classList.remove('visible');
            }
        }

        if (window.innerWidth <= 768) {
            const stickyObs = new IntersectionObserver((entries) => {
                pastHero = !entries[0].isIntersecting;
                updateSticky();
            }, { threshold: 0.1 });
            stickyObs.observe(heroSection);

            const pricingObs2 = new IntersectionObserver((entries) => {
                inPricing = entries[0].isIntersecting;
                updateSticky();
            }, { threshold: 0.05 });
            pricingObs2.observe(pricingSection);
        }

        // 3. WHATSAPP VOICE MESSAGE PLAYERS
        let currentAudio = null;
        let currentPlayer = null;
        const speeds = [1, 1.5, 2];

        document.querySelectorAll('.wa-voice').forEach(player => {
            const btn = player.querySelector('.wa-voice__btn');
            const playIcon = player.querySelector('.icon-play');
            const pauseIcon = player.querySelector('.icon-pause');
            const timeEl = player.querySelector('.wa-voice__time');
            const durationEl = player.querySelector('.wa-voice__duration');
            const bars = player.querySelectorAll('.wa-voice__wave span');
            const dot = player.querySelector('.wa-voice__dot');
            const speedBtn = player.querySelector('.wa-voice__speed');
            const src = player.dataset.src;
            let audio = null;
            let speedIdx = 0;

            function formatTime(s) {
                const m = Math.floor(s / 60);
                const sec = Math.floor(s % 60);
                return m + ':' + String(sec).padStart(2, '0');
            }

            function resetPlayer() {
                player.classList.remove('playing');
                playIcon.style.display = 'block'; pauseIcon.style.display = 'none';
                bars.forEach(b => b.classList.remove('played'));
                dot.style.left = '0%';
                if (audio) { timeEl.textContent = formatTime(audio.duration || 0); audio.currentTime = 0; }
            }

            function updateProgress() {
                if (!audio || !audio.duration) return;
                const pct = (audio.currentTime / audio.duration);
                timeEl.textContent = formatTime(audio.currentTime);
                const playedCount = Math.floor(pct * bars.length);
                bars.forEach((bar, i) => bar.classList.toggle('played', i < playedCount));
                dot.style.left = (pct * 100) + '%';
                if (!audio.paused) requestAnimationFrame(updateProgress);
            }

            // Speed toggle
            speedBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                speedIdx = (speedIdx + 1) % speeds.length;
                const spd = speeds[speedIdx];
                speedBtn.textContent = spd + '.0x'.replace('.0', spd % 1 === 0 ? '.0' : '');
                speedBtn.textContent = spd === 1 ? '1.0x' : spd === 1.5 ? '1.5x' : '2.0x';
                if (audio) audio.playbackRate = spd;
            });

            btn.addEventListener('click', () => {
                if (!audio) {
                    audio = new Audio(src);
                    audio.addEventListener('ended', resetPlayer);
                    audio.addEventListener('loadedmetadata', () => {
                        durationEl.textContent = formatTime(audio.duration);
                        timeEl.textContent = formatTime(audio.duration);
                    });
                }

                if (currentAudio && currentAudio !== audio) {
                    currentAudio.pause(); currentAudio.currentTime = 0;
                    currentPlayer.classList.remove('playing');
                    currentPlayer.querySelector('.icon-play').style.display = 'block';
                    currentPlayer.querySelector('.icon-pause').style.display = 'none';
                    currentPlayer.querySelectorAll('.wa-voice__wave span').forEach(b => b.classList.remove('played'));
                    currentPlayer.querySelector('.wa-voice__dot').style.left = '0%';
                }

                if (audio.paused) {
                    audio.playbackRate = speeds[speedIdx];
                    audio.play(); player.classList.add('playing');
                    playIcon.style.display = 'none'; pauseIcon.style.display = 'block';
                    currentAudio = audio; currentPlayer = player; updateProgress();
                } else {
                    audio.pause(); player.classList.remove('playing');
                    playIcon.style.display = 'block'; pauseIcon.style.display = 'none';
                }
            });
        });

        // 4. YES LADDER LOGIC (Micro-commitment checkboxes)
        document.querySelectorAll('.commit-checkbox').forEach(check => {
            check.addEventListener('change', function() {
                const targetBtn = document.getElementById(this.dataset.target);
                if (this.checked) {
                    targetBtn.classList.remove('btn-disabled');
                    targetBtn.innerHTML = targetBtn.innerHTML.replace('Liberar Compra Base', 'Comprar Agora');
                } else {
                    targetBtn.classList.add('btn-disabled');
                }
            });
        });

        // 4b. NUDGE commitment box when clicking disabled button
        ['btnBasic','btnPremium'].forEach(id => {
            document.getElementById(id).addEventListener('click', function(e) {
                if (this.classList.contains('btn-disabled')) {
                    e.preventDefault();
                    const commitBox = this.closest('.pricing-card').querySelector('.commitment-box');
                    commitBox.classList.remove('commitment-nudge');
                    void commitBox.offsetWidth; // force reflow
                    commitBox.classList.add('commitment-nudge');
                    setTimeout(() => commitBox.classList.remove('commitment-nudge'), 1200);
                }
            });
        });

        // 5. BONUS SCARCITY TIMER (2d 8h 49min)
        (function() {
            let bonusEndTime = localStorage.getItem('cen_bonus_v3');
            if (!bonusEndTime || Number(bonusEndTime) <= Date.now()) { 
                bonusEndTime = Date.now() + ((2*24*60*60*1000) + (8*60*60*1000) + (49*60*1000)); 
                localStorage.setItem('cen_bonus_v3', bonusEndTime); 
            }
            function updateBonusTimer() {
                const diff = Math.max(0, bonusEndTime - Date.now());
                const d = Math.floor(diff / 86400000);
                const h = Math.floor((diff % 86400000) / 3600000);
                const m = Math.floor((diff % 3600000) / 60000);
                const s = Math.floor((diff % 60000) / 1000);
                
                if (diff === 0) {
                    document.getElementById('bonusContainer').classList.add('expired');
                    document.getElementById('bonusContainer').innerHTML = '<span style="font-size:11px; color:rgba(255,255,255,0.3);">❌ Bônus expirado</span>';
                } else {
                    document.getElementById('bonusTimer').textContent = d + 'd ' + h + 'h ' + m + 'min ' + s + 'seg';
                    requestAnimationFrame(updateBonusTimer);
                }
            }
            updateBonusTimer();
        })();

        // 6. QUIZ LOGIC, FAKE AI & DYNAMIC COPY
        (function() {
            const overlay = document.getElementById('quizOverlay');
            const state = { nome: '', frustracao: '', faturamento: '' };
            let currentStep = 0;

            // WPP Mask
            const wppInput = document.getElementById('quizWhatsapp');
            wppInput.addEventListener('input', function(e) {
                let v = e.target.value.replace(/\D/g, '');
                if(v.length>11) v=v.slice(0,11);
                if(v.length>7) e.target.value = `(${v.slice(0,2)}) ${v.slice(2,7)}-${v.slice(7)}`;
                else if(v.length>2) e.target.value = `(${v.slice(0,2)}) ${v.slice(2)}`;
                else if(v.length>0) e.target.value = `(${v}`;
            });

            function goStep(num) {
                document.querySelector(`.quiz-step[data-step="${currentStep}"]`).classList.remove('active');
                const next = document.querySelector(`.quiz-step[data-step="${num}"]`);
                next.style.animation = 'none'; next.offsetHeight; next.style.animation = ''; 
                next.classList.add('active');
                
                if(num >= 1 && num < 5) {
                    document.getElementById('quizHeader').style.display = 'flex';
                    document.getElementById('qCounter').innerText = `Passo ${num} de 4`;
                    document.getElementById('qFill').style.width = `${(num/4)*100}%`;
                } else {
                    document.getElementById('quizHeader').style.display = 'none';
                }
                currentStep = num;

                if (num === 5) runFakeAI();
            }

            function runFakeAI() {
                const steps = document.querySelectorAll('.diag-step');
                const percentEl = document.getElementById('diagPercent');
                const targets = [21, 48, 72, 84];
                let currentPercent = 0;
                
                function animatePercent(target, duration, callback) {
                    const start = currentPercent;
                    const startTime = Date.now();
                    function tick() {
                        const elapsed = Date.now() - startTime;
                        const progress = Math.min(elapsed / duration, 1);
                        const eased = 1 - Math.pow(1 - progress, 3);
                        currentPercent = Math.round(start + (target - start) * eased);
                        percentEl.textContent = currentPercent + '%';
                        if (progress < 1) { requestAnimationFrame(tick); }
                        else if (callback) { callback(); }
                    }
                    tick();
                }
                
                function runStep(idx) {
                    if (idx >= steps.length) {
                        setTimeout(() => {
                            document.getElementById('aiLoader').style.display = 'none';
                            document.getElementById('diagResult').style.display = 'block';
                            document.getElementById('diagResult').classList.add('diag-result-anim');
                        }, 600);
                        return;
                    }
                    const step = steps[idx];
                    const fill = step.querySelector('.diag-step__fill');
                    step.classList.add('active');
                    fill.style.width = '100%';
                    
                    animatePercent(targets[idx], 1000, () => {
                        step.classList.remove('active');
                        step.classList.add('done');
                        setTimeout(() => runStep(idx + 1), 200);
                    });
                }
                
                setTimeout(() => runStep(0), 400);
            }

            document.getElementById('quizStartBtn').addEventListener('click', () => {
                const nameInput = document.getElementById('quizNameInput');
                if (nameInput.value.trim().length < 2) { nameInput.classList.add('error'); setTimeout(()=>nameInput.classList.remove('error'), 500); return; }
                state.nome = nameInput.value.trim().split(' ')[0];
                state.nome = state.nome.charAt(0).toUpperCase() + state.nome.slice(1).toLowerCase();
                
                document.querySelectorAll('.q-name').forEach(el => el.innerText = state.nome);
                goStep(1);
            });

            document.querySelectorAll('.quiz-option').forEach(opt => {
                opt.addEventListener('click', function() {
                    const stepEl = this.closest('.quiz-step');
                    const stepNum = parseInt(stepEl.dataset.step);
                    stepEl.querySelectorAll('.quiz-option').forEach(o => o.classList.remove('selected'));
                    this.classList.add('selected');
                    
                    if (stepNum === 3) state.frustracao = this.dataset.val;
                    if (stepNum === 4) state.faturamento = this.dataset.val;
                    
                    setTimeout(() => goStep(stepNum + 1), 400);
                });
            });

            document.getElementById('quizSubmitBtn').addEventListener('click', async () => {
                if(wppInput.value.replace(/\D/g, '').length < 10) { wppInput.classList.add('error'); setTimeout(()=>wppInput.classList.remove('error'), 500); return; }

                // Webhook (Silencioso)
                fetch('https://webhook.fiqon.app/webhook/019c2f82-521e-7058-b222-bf4f90d02a76/91d6bb05-0ba2-46dc-8bb4-8ae7248dfa91', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ nome: state.nome, whatsapp: wppInput.value, frustracao: state.frustracao, fat: state.faturamento })
                }).catch(e => console.log(e));

                // MAGIC: DYNAMIC COPY INJECTION
                document.querySelectorAll('.user-name-inline').forEach(el => { el.textContent = state.nome + ', '; el.classList.add('visible'); });
                document.querySelectorAll('.enemy-name').forEach(el => { el.textContent = state.nome; });
                
                let mMsg = "";
                let hTitle = "";
                let hSub = "";
                let eText = "";

                // Verifica Dores (Step 3)
                if (state.frustracao === 'postar') {
                    mMsg = "A pior mentira que te contaram é que você precisa ter as visualizações ou alcance de um blogueiro viralizado pra vender. Pare de ser trouxa.";
                    hTitle = `Comece a Ganhar <span class="text-accent">10 Clientes por Dia</span><br>Sem Precisar Virar Refém do Algoritmo.`;
                    hSub = `Pare de postar todo santo dia para não ter retorno nenhum. O Funil Invisível cria vendas no automático, trabalhando 15 min por dia.`;
                    eText = `Por anos os gurus disseram: "Você precisa produzir conteúdo de valor todos os dias". <b style="color:#fff;">Mentira.</b> Eles falam isso porque <b style="color:#fff;">já são famosos</b>. Para quem não tem milhões de seguidores, postar sem um Funil é falar sozinho para as paredes. O <b style="color:#10B981;">Funil Invisível™</b> inverte essa lógica.`;
                } else if (state.frustracao === 'ads') {
                    mMsg = "Zuckerberg está ficando rico com o seu dinheiro, e você está ficando frustrado. Vamos fechar a torneira do tráfego pago hoje.";
                    hTitle = `Comece a Atrair <span class="text-accent">10 Clientes por Dia</span><br>Sem Gastar 1 Centavo no Face Ads.`;
                    hSub = `Chega de queimar dinheiro em campanhas que não convertem ou tomar bloqueio. Ative o fluxo orgânico magnético.`;
                    eText = `A pior sensação do mundo é <b style="color:#fff;">ver o cartão sendo cobrado pelo Facebook</b> e não ver nenhuma venda caindo na conta. O jogo do tráfego pago ficou <b style="color:#fff;">caro e complexo de propósito</b>. O <b style="color:#10B981;">Funil Invisível™</b> é o botão de resgate: zero anúncios, tráfego orgânico altamente qualificado.`;
                } else {
                    mMsg = "A esperança não é uma estratégia de negócios. Esperar por indicação é pedir para falir. Assuma o controle hoje.";
                    hTitle = `Comece a Criar Seu <span class="text-accent">Fluxo de Clientes Diário</span><br>Sem Depender de Indicação.`;
                    hSub = `Transforme desconhecidos do Instagram em clientes pagantes no WhatsApp com uma sequência simples e previsível.`;
                    eText = `Você é bom no que faz, <b style="color:#fff;">seus clientes atuais elogiam</b>, mas você não tem controle de quando o próximo vai chegar. Depender de boca-a-boca é viver numa <b style="color:#fff;">montanha-russa financeira</b>. O <b style="color:#10B981;">Funil Invisível™</b> coloca o volante do seu negócio na sua mão: você aciona, o cliente vem.`;
                }

                // Aplica Textos
                document.getElementById('mindReaderMsg').innerHTML = `<strong>Aviso para ${state.nome}:</strong> ${mMsg} Segue o plano abaixo.`;
                document.getElementById('mindReaderAlert').style.display = 'block';
                document.getElementById('hTitle').innerHTML = `<span class="user-name-inline visible">${state.nome},</span><br>` + hTitle;
                document.getElementById('pHeroAccent').innerHTML = hSub;
                document.getElementById('eText').innerHTML = eText;

                // Destrava a página
                overlay.classList.add('hidden');
                document.body.style.overflow = '';
                fbq('trackCustom', 'CompletouQuiz', { nome: state.nome, frustracao: state.frustracao, faturamento: state.faturamento });
                setTimeout(() => {
                    window.scrollTo({ top: 0, behavior: 'instant' });
                }, 100);
            });
        })();

        // 7. PIXEL EVENTS: Scroll 30% + Visualizou Pricing
        (function() {
            let fired30 = false;
            let firedPricing = false;

            // Scroll 30%
            window.addEventListener('scroll', function() {
                if (fired30) return;
                const scrollPct = (window.scrollY + window.innerHeight) / document.documentElement.scrollHeight;
                if (scrollPct >= 0.3) {
                    fbq('trackCustom', 'Visualizou30');
                    fired30 = true;
                }
            });

            // Visualizou Pricing
            const pricingEl = document.getElementById('pricing');
            if (pricingEl) {
                const pricingObs = new IntersectionObserver(function(entries) {
                    if (entries[0].isIntersecting && !firedPricing) {
                        fbq('trackCustom', 'VisualizouPricing');
                        firedPricing = true;
                        pricingObs.disconnect();
                    }
                }, { threshold: 0.2 });
                pricingObs.observe(pricingEl);
            }
        })();
    </script>
